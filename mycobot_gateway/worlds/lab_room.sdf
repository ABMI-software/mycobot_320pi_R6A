<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="empty">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- Scene: warm ambient, light grey-blue background like a lit lab room -->
    <scene>
      <ambient>0.55 0.52 0.48 1.0</ambient>
      <background>0.80 0.82 0.86 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Primary: warm directional light from upper-left (window / daylight) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.88 0.75 1</diffuse>
      <specular>0.40 0.36 0.30 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 -0.25 -0.88</direction>
    </light>

    <!-- Fill: cooler softer light from opposite side (skylight / ceiling) -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.38 0.42 0.55 1</diffuse>
      <specular>0.05 0.05 0.10 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.4 0.25 -0.60</direction>
    </light>

    <!-- Back fill: soft neutral from above to lighten deep shadows -->
    <light type="directional" name="back_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.20 0.20 0.22 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.0 0.0 -1.0</direction>
    </light>

    <!-- Lab floor: warm light concrete/tile -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.68 0.66 0.62 1</ambient>
            <diffuse>0.72 0.70 0.66 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
