<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_moveit_config</name>
  <version>1.0.0</version>
  <description>Hand-authored MoveIt2 configuration for the MyCobot 320 Pi digital twin, targeting the mycobot_description Gazebo URDF and the existing mycobot_controller joint_trajectory_controller.</description>
  <maintainer email="tomislav_tole_ilic@yahoo.com">Tomislav Ilic</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mycobot_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
