<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="red_block">
    <link name="link">

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.333e-05</ixx>
          <iyy>1.333e-05</iyy>
          <izz>1.333e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.04 0.04 0.04</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>5e4</kp>
              <kd>50.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.04 0.04 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.05 0.05 1</ambient>
          <diffuse>0.9 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

    </link>

    <!-- SIMULATED ATTACHMENT, NOT A PHYSICAL GRASP. Welds this block to the
         robot link6 (gripper_base is lumped into it) on a message to /htgpp/attach and releases it on
         /htgpp/detach. Used because a friction grasp was not achieved in this
         sim (see MEASUREMENTS.md). -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>link</parent_link>
      <child_model>mycobot_320</child_model>
      <child_link>link6</child_link>
      <attach_topic>/htgpp/attach</attach_topic>
      <detach_topic>/htgpp/detach</detach_topic>
      <output_topic>/htgpp/attached</output_topic>
    </plugin>
  </model>
</sdf>
