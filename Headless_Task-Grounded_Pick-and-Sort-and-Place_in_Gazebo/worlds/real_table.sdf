<?xml version="1.0"?>
<!-- Real worktop for MyCobot: 622 x 449 x 8.5 mm (user measurement 2026-09-09).
     Robot base remains at world origin; X forward, Y left, Z up.
     Board placement is inferred from calibration notes, not a new measurement.
     ArUco black squares: 50 mm, DICT_4X4_50 (same IDs in DICT_4X4_1000).
     Launch: ros2 launch mycobot_gateway real_table.launch.py
-->
<sdf version="1.9">
  <world name="real_table">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!-- The spawned MyCobot URDF loads the shared Sensors system. Loading a
         second instance here creates two Ogre scenes and crashes rendering. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.82 0.85 1</background>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.9</direction>
    </light>
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.3 -0.7</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.6 0.6 0.57 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.0085 0 0 0</pose>
    </model>
    <!--622 mm along X, 449 mm along Y, 8.5 mm thick. Top Z=0; near edge X=-50 mm.-->
    <model name="table">
      <static>true</static>
      <pose>0.261 0.017 -0.00425 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <!-- Explicit UVs: the full wood image covers the board once,
               with the grain running along its 622 mm length (+X). -->
          <geometry>
            <mesh>
              <uri>package://mycobot_description/models/wood_table/meshes/tabletop.dae</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <pbr>
              <metal>
                <albedo_map>package://mycobot_description/models/wood_table/materials/textures/wood_albedo.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.65</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.622 0.449 0.0085</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    <!--Optional physical demo: red cube to red bin, both inside the measured board.-->
    <model name="red_cube">
      <pose>0.22 -0.08 0.020 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.05 0.05 1</ambient>
            <diffuse>0.95 0.10 0.10 1</diffuse>
            <specular>0.4 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx>
            <iyy>1.33e-5</iyy>
            <izz>1.33e-5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    <model name="red_bin">
      <static>true</static>
      <pose>0.22 0.10 0 0 0 0</pose>
      <link name="link">
        <visual name="floor">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="wn">
          <pose>0 0.05 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.005 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="ws">
          <pose>0 -0.05 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.005 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="we">
          <pose>0.05 0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.10 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="ww">
          <pose>-0.05 0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.10 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <collision name="floor_c">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 0.002</size>
            </box>
          </geometry>
        </collision>
        <collision name="wn_c">
          <pose>0 0.05 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.005 0.03</size>
            </box>
          </geometry>
        </collision>
        <collision name="ws_c">
          <pose>0 -0.05 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.005 0.03</size>
            </box>
          </geometry>
        </collision>
        <collision name="we_c">
          <pose>0.05 0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.10 0.03</size>
            </box>
          </geometry>
        </collision>
        <collision name="ww_c">
          <pose>-0.05 0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.10 0.03</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <!--4-object sort, added for LeRobot data acquisition (Osama's setup, 4 couleurs).
         Pick column at X=0.10 m (clear of both near ArUco tags by >=60 mm and of
         red_cube/red_bin by >=120 mm on X alone); bin column at X=0.33-0.34 m
         (clear of red_bin by >=100 mm on X alone; max bin radius 0.371 m, under
         the measured ~0.39 m reach envelope). Same object/bin primitives as
         pick_and_place_sorting.sdf, repositioned for this board; see CHANGELOG.-->
    <model name="blue_cube">
      <pose>0.10 -0.06 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.10 0.7 1</ambient>
            <diffuse>0.10 0.20 0.95 1</diffuse>
            <specular>0.1 0.1 0.4 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>2.5e-5</ixx>
            <iyy>2.5e-5</iyy>
            <izz>2.5e-5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    <model name="green_cylinder">
      <pose>0.10 0.02 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.05</length>
