<?xml version="1.0" ?>
<!-- Extracted verbatim from mycobot_320pi_R6A/mycobot_description/worlds/real_table.sdf
     (branch feature/pick-and-place-osama, added this session). World pose there: 0.10 0.02 0.025.
     NOTE: on pick_and_place_sorting.sdf, this shape has a known, unresolved
     drop-release bug (rolls 8-12 cm out of its bin); see CHANGELOG.md 22/09.
     Not yet verified whether it reproduces on real_table.sdf's bin geometry. -->
<sdf version="1.9">
  <model name="green_cylinder">
    <link name="link">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.022</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.55 0.10 1</ambient>
          <diffuse>0.10 0.80 0.15 1</diffuse>
          <specular>0.1 0.4 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.022</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.25e-5</ixx>
          <iyy>1.25e-5</iyy>
          <izz>1.21e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <!-- SIMULATED ATTACHMENT, NOT A PHYSICAL GRASP (Part 3/A8 decision;
         doc/GRASP_DECISION.md). See red_cube.sdf for the full rationale. -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>link</parent_link>
      <child_model>mycobot_320</child_model>
      <child_link>link6</child_link>
      <attach_topic>/htgspp/attach</attach_topic>
      <detach_topic>/htgspp/detach</detach_topic>
      <output_topic>/htgspp/attached</output_topic>
    </plugin>
  </model>
</sdf>
