<?xml version="1.0"?>
<window>
  <width>1600</width><height>900</height>
  <dialog_on_exit>true</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><title>Robot et trajectoire</title><property type="bool" key="showTitleBar">false</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.5 0.5 0.5</ambient_light>
  <background_color>0.8 0.82 0.85</background_color>
  <camera_pose>0.75 -0.83 0.62 0 0.5 2.16</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui>
</plugin>
<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui>
</plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui><title>Lecture / pause</title></gz-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused><use_event>true</use_event>
</plugin>
<!-- What yolo26 sees on the top DREAM camera, cropped on the pieces and
     drawn like the real bench (box, "class confidence" label), plus the XY
     error against the Gazebo ground truth per piece. Published by
     yolo_gt_overlay, bridged ROS -> gz in tri_yolo.launch.py. Validation
     only. Docked under the play controls; the side bar takes the width of
     its widest panel and is widened by dragging its left edge. -->
<plugin filename="ImageDisplay" name="YOLO vs GT">
  <gz-gui><title>YOLO vs vérité terrain</title></gz-gui>
  <topic>/validation/yolo_gt/image</topic>
  <topic_picker>false</topic_picker>
</plugin>
<!-- Gripper trajectories (one colour per object) and DREAM's estimate are
     drawn as markers by tri_trajectoires_gazebo (dream:=true), which replaced
     the single-colour Plot3D trail. -->
