<?xml version="1.0" ?>
<!--
  Domain-randomized Gazebo world for synthetic data collection.

  Features:
  - Directional sun with randomisable direction
  - Ground plane with texturable surface
  - Several coloured background objects for visual variety
  - Physics settings tuned for pose-estimation data collection
-->
<sdf version="1.9">
  <world name="randomized">

    <!-- Scene: bright, neutral office ambient.
         Without a <scene> block Gazebo defaults to a very low ambient, which
         left every surface that wasn't hit by direct sun in deep grey/black
         (the robot's white plastic rendered as mid-grey). The real arducam /
         svpro / astra captures are taken in a bright fluorescent + daylight
         office with strong bounced (ambient) light, so we raise the global
         ambient and use a light, slightly-cool background. -->
    <scene>
      <!-- Bright, clean, NEUTRAL-WHITE office light (like the real captures).
           High ambient so the whole scene reads bright/clean and white — the
           joint articulations are made visible by image sharpening in post, NOT
           by darkening the scene, so we no longer trade brightness for contrast.
           Ambient/background are pure neutral grey (r=g=b) → zero colour cast. -->
      <ambient>0.56 0.56 0.56 1</ambient>
      <background>0.84 0.84 0.84 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Physics -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <!-- Sun (main directional light) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- Secondary fill light (softer, from opposite side) -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>0.5 -0.3 -0.7</direction>
    </light>

    <!-- Point light (neutral white, positioned near robot) -->
    <light type="point" name="warm_point">
      <cast_shadows>false</cast_shadows>
      <pose>1.0 0.5 1.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>5</range>
        <constant>0.5</constant>
        <linear>0.2</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane (dropped 1.5 cm below the table top to avoid z-fighting
         stripes on the tabletop in the overhead view) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <!-- Neutral grey office carpet (the real captures sit on grey carpet,
               not the previous greenish floor). Low specular = matte fabric. -->
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.34 0.34 0.35 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Background objects for visual clutter / domain randomization -->

    <!-- Back wall (light, near-white office partition) -->
    <model name="back_wall">
      <static>true</static>
      <pose>-1.5 0 0.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 3.0 1.5</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Side panel (light, near-white office partition) -->
    <model name="side_panel">
      <static>true</static>
      <pose>0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 0.05 1.0</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table / desktop under robot — large enough to fill the lower frame in
         all 4 (now wider-FOV) camera views, like a real office desk. -->
    <model name="table">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.9 0.9 0.04</size></box></geometry>
          <!-- Real warm-pine plywood desktop (grain + knots), matching the
               wooden board the robot is mounted on in the office captures.
               Uses a PBR albedo texture; ambient/diffuse kept as a fallback
               tint for renderers that ignore PBR maps. -->
          <material>
            <ambient>0.50 0.38 0.24 1</ambient>
            <diffuse>0.70 0.54 0.34 1</diffuse>
            <specular>0.05 0.04 0.03 1</specular>
            <pbr>
              <metal>
                <albedo_map>/home/genji/ros_jazzy/src/mycobot_R6A/mycobot_description/materials/textures/wood_desk.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.9 0.9 0.04</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Random clutter boxes -->
    <model name="clutter_box_1">
      <static>true</static>
      <pose>0.4 0.5 0.05 0 0 0.3</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 0.08 0.1</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.8 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="clutter_box_2">
      <static>true</static>
      <pose>-0.3 0.4 0.075 0 0 -0.5</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.12 0.06 0.15</size></box></geometry>
          <material>
            <ambient>0.2 0.6 0.3 1</ambient>
            <diffuse>0.25 0.7 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="clutter_cylinder">
      <static>true</static>
      <pose>0.3 -0.4 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.2</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.3 0.7 1</ambient>
            <diffuse>0.25 0.35 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
