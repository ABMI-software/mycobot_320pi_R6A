<?xml version="1.0"?>
<!-- Genere par scripts/generer_pieces_gazebo.py — regenerer plutot qu'editer.
     Cotes lues dans tri_couleur.OBJET_PAR_COULEUR['bleu'] : (50.0, 50.0, 50.0) mm.
     Origine au CENTRE DE LA BASE : une pose a Z=0 repose sur la planche. -->
<sdf version="1.9">
  <model name="cube_bleu">
    <link name="corps">
      <pose>0 0 0.025000 0 0 0</pose>
      <inertial>
        <mass>0.062500</mass>
        <inertia>
          <ixx>0.000026042</ixx><iyy>0.000026042</iyy><izz>0.000026042</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.050000 0.050000 0.050000</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.050000 0.050000 0.050000</size></box></geometry>
        <material>
          <ambient>0.039 0.486 0.647 1</ambient>
          <diffuse>0.039 0.486 0.647 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
